<div class="inline-search" data-search-root>
  <button class="search-trigger" type="button" data-open-search aria-label="搜索文章">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="5.8"></circle><path d="m16 16 4.2 4.2"></path></svg><span>搜索</span>
  </button>
  <div class="search-expanded">
    <div class="search-input-wrap"><input data-search-input type="search" autocomplete="off" placeholder="搜索文章…" aria-label="搜索文章" /><button class="close" type="button" data-close-search aria-label="关闭搜索">×</button></div>
    <div class="search-results" data-search-results></div>
  </div>
</div>
<script is:inline>
  const root = document.querySelector('[data-search-root]');
  const input = document.querySelector('[data-search-input]');
  const results = document.querySelector('[data-search-results]'); let pagefind;
  async function getPagefind() { if (!pagefind) pagefind = await import('/pagefind/pagefind.js'); return pagefind; }
  function openSearch() { root.classList.add('is-open'); input.focus(); }
  function closeSearch() { root.classList.remove('is-open'); input.value = ''; results.replaceChildren(); }
  document.querySelector('[data-open-search]').addEventListener('click', openSearch);
  document.querySelector('[data-close-search]').addEventListener('click', closeSearch);
  document.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openSearch(); } if (event.key === 'Escape') closeSearch(); });
  input.addEventListener('input', async (event) => {
    const query = event.target.value.trim(); results.replaceChildren(); if (!query) return; results.innerHTML = '<p>正在搜索…</p>';
    try { const finder = await getPagefind(); const response = await finder.search(query); const entries = await Promise.all(response.results.slice(0, 7).map((result) => result.data())); results.replaceChildren(); if (!entries.length) { results.innerHTML = '<p>没有找到相关文章。</p>'; return; } entries.forEach((entry) => { const link = document.createElement('a'); link.href = entry.url; link.className = 'search-result'; const title = document.createElement('strong'); title.textContent = entry.meta.title || '未命名文章'; const excerpt = document.createElement('span'); excerpt.textContent = entry.excerpt.replace(/<[^>]*>/g, '').trim(); link.append(title, excerpt); results.append(link); }); } catch { results.innerHTML = '<p>搜索索引尚未生成。</p>'; }
  });
</script>
<style>
  .inline-search { position:relative; } .search-trigger { display:inline-flex; align-items:center; gap:5px; padding:4px 0; border:0; background:transparent; color:var(--muted); font:15px 'LXGW WenKai GB',sans-serif; cursor:pointer; } .search-trigger:hover { color:var(--accent); } .search-trigger svg { width:16px; fill:none; stroke:currentColor; stroke-width:1.8; }
  .search-expanded { display:none; width:min(320px, 55vw); } .inline-search.is-open .search-trigger { display:none; } .inline-search.is-open .search-expanded { display:block; }
  .search-input-wrap { display:flex; align-items:center; gap:8px; height:32px; padding:0 7px 0 10px; border:1px solid #d7b69a; border-radius:8px; background:#fff; box-shadow:0 1px 3px #95765518; } .search-input-wrap input { min-width:0; flex:1; border:0; outline:0; background:transparent; color:var(--ink); font:14px 'LXGW WenKai GB',serif; } .search-input-wrap input::placeholder { color:#ae9f90; } .close { padding:0; border:0; background:transparent; color:#6d5f50; font:22px/1 system-ui,sans-serif; cursor:pointer; } .close:hover { color:var(--accent); }
  .search-results { position:absolute; z-index:2; top:40px; right:0; width:100%; max-height:350px; overflow:auto; background:#fff; box-shadow:0 9px 25px #5e4a2920; } .search-results:empty { display:none; } .search-results > p { margin:0; padding:13px; color:var(--muted); font:13px system-ui,sans-serif; } .search-result { display:block; padding:11px 13px; border-bottom:1px solid var(--line); } .search-result:hover { background:#fcf8f2; } .search-result strong { display:block; font-size:16px; font-weight:500; } .search-result span { display:-webkit-box; overflow:hidden; margin-top:3px; color:var(--muted); font:12px/1.45 system-ui,sans-serif; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
  @media(max-width:560px) { .search-trigger span { display:none; } .search-expanded { width:190px; } }
</style>
