<div class="inline-search" data-search-root>
  <button class="search-trigger" type="button" data-open-search aria-label="搜索文章" title="搜索文章">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="5.8"></circle><path d="m16 16 4.2 4.2"></path></svg>
  </button>
  <form class="search-expanded" role="search" action="/search" method="get" data-search-form>
    <div class="search-box">
      <input type="search" name="q" autocomplete="off" placeholder="搜索文章…" aria-label="搜索文章" data-search-input />
      <button type="submit" class="search-go" aria-label="开始搜索">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="5.8"></circle><path d="m16 16 4.2 4.2"></path></svg>
      </button>
      <button type="button" class="search-clear" data-clear-search aria-label="删除输入内容">×</button>
    </div>
    <button type="button" class="search-close" data-close-search aria-label="关闭搜索">×</button>
  </form>
</div>
<script is:inline>
  (() => {
    const initSearch = (root) => {
      const trigger = root.querySelector('[data-open-search]');
      const form = root.querySelector('[data-search-form]');
      const input = form && form.querySelector('[data-search-input]');
      const closeButton = form && form.querySelector('[data-close-search]');
      const clearButton = form && form.querySelector('[data-clear-search]');
      if (!trigger || !form || !input) return;

      // Empty input: show the search button. Non-empty: swap it for the delete button.
      const sync = () => { form.classList.toggle('has-query', input.value.length > 0); };
      const open = () => { root.classList.add('is-open'); input.focus(); input.select(); sync(); };
      const close = () => { root.classList.remove('is-open'); };
      const submit = () => {
        const query = input.value.trim();
        if (query) window.location.assign(`/search?q=${encodeURIComponent(query)}`);
        else input.focus();
      };

      trigger.addEventListener('click', open);
      if (closeButton) closeButton.addEventListener('click', close);
      if (clearButton) {
        clearButton.addEventListener('click', () => {
          input.value = '';
          sync();
          input.focus();
        });
      }
      input.addEventListener('input', sync);
      form.addEventListener('submit', (event) => { event.preventDefault(); submit(); });
      input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || event.isComposing) return;
        event.preventDefault();
        submit();
      });
      root.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && root.classList.contains('is-open')) close();
      });

      // Coming back from the results page should show the query again.
      const active = new URLSearchParams(window.location.search).get('q');
      if (active) { input.value = active; root.classList.add('is-open'); }
      sync();
    };

    document.querySelectorAll('[data-search-root]').forEach(initSearch);
    document.addEventListener('keydown', (event) => {
      if (!((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) return;
      const trigger = document.querySelector('[data-open-search]');
      if (!trigger) return;
      event.preventDefault();
      trigger.click();
    });
  })();
</script>
<style>
  .inline-search { position:relative; }
  .search-trigger { display:inline-flex; align-items:center; padding:4px 0; border:0; background:transparent; color:var(--muted); cursor:pointer; } .search-trigger:hover { color:var(--accent); } .search-trigger svg { width:16px; fill:none; stroke:currentColor; stroke-width:1.8; }
  .search-expanded { display:none; align-items:center; gap:6px; margin:0; }
  .inline-search.is-open .search-trigger { display:none; } .inline-search.is-open .search-expanded { display:flex; }
  .search-box { display:flex; align-items:center; gap:5px; width:min(300px, 50vw); height:32px; padding:0 7px 0 10px; border:1px solid #d7b69a; border-radius:8px; background:#fff; box-shadow:0 1px 3px #95765518; }
  .search-box input { min-width:0; flex:1; border:0; outline:0; background:transparent; color:var(--ink); font:14px 'LXGW WenKai GB',serif; } .search-box input::placeholder { color:#ae9f90; }
  .search-box input::-webkit-search-cancel-button, .search-box input::-webkit-search-decoration { -webkit-appearance:none; appearance:none; }
  .search-go, .search-clear { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; padding:0; border:0; background:transparent; cursor:pointer; }
  .search-go { border-radius:6px; background:var(--soft); color:var(--accent); } .search-go:hover { background:#f1e3d3; } .search-go svg { width:14px; fill:none; stroke:currentColor; stroke-width:2; }
  .search-clear { display:none; color:#8a7c6d; font:19px/1 system-ui,sans-serif; } .search-clear:hover { color:var(--accent); }
  .search-expanded.has-query .search-go { display:none; } .search-expanded.has-query .search-clear { display:inline-flex; }
  .search-close { flex:none; padding:1px 2px; border:0; background:transparent; color:#8a7c6d; font:19px/1 system-ui,sans-serif; cursor:pointer; } .search-close:hover { color:var(--accent); }
  @media(max-width:560px) { .search-box { width:min(210px, 45vw); } }
</style>
