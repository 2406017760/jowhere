---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="page-head">
    <p class="eyebrow">PERSONAL NOTES</p>
    <h1 class="page-title">一些思考，<br />一些正在发生的事。</h1>
    <p class="page-intro">在这里记录技术、阅读、旅行与日常。</p>
  </section>
  <PostList {posts} />
</BaseLayout>
