---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="intro">
    <p class="eyebrow">PERSONAL NOTES</p>
    <h1>一些思考，<br />一些正在发生的事。</h1>
    <p>在这里记录技术、阅读、旅行与日常。</p>
  </section>
  <PostList {posts} />
</BaseLayout>
<style>
  .intro { margin:32px 0 18px; padding:31px 29px; border:1px solid var(--line); border-radius:8px; background:#fff; box-shadow:0 2px 6px #6a51310a; } h1 { margin:0; font-size:39px; line-height:1.35; letter-spacing:.02em; font-weight:600; } .intro > p:last-child { margin:13px 0 0; color:var(--muted); }
  @media(max-width:560px) { h1 { font-size:32px; } }
</style>
