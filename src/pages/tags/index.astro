---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = new Map<string, number>();
posts.flatMap(post => post.data.tags).forEach(tag => counts.set(tag, (counts.get(tag) ?? 0) + 1));
const tags = [...counts.entries()].sort(([a],[b]) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title="标签">
  <section class="page-head">
    <p class="eyebrow">TAGS</p>
    <h1 class="page-title">主题索引</h1>
    <p class="page-intro">从一个关键词开始阅读。</p>
  </section>
  <div class="tag-list">
    {tags.map(([tag, count]) => <a class="card" href={`/tags/${encodeURIComponent(tag)}`}><span>#{tag}</span><small>{count}</small></a>)}
  </div>
</BaseLayout>
<style>
 .tag-list { display:grid; gap:18px; } .tag-list a { display:flex; justify-content:space-between; align-items:center; padding:19px 29px; font:17px system-ui,sans-serif; } .tag-list a:hover { border-color:#ead6bd; background:var(--soft); color:var(--accent); } small { color:var(--muted); font-size:13px; }
</style>
