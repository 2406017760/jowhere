---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = new Map<string, number>();
posts.flatMap(post => post.data.tags).forEach(tag => counts.set(tag, (counts.get(tag) ?? 0) + 1));
const tags = [...counts.entries()].sort(([a],[b]) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title="标签">
  <section class="tags"><p class="eyebrow">TAGS</p><h1 class="page-title">主题索引</h1><p class="page-intro">从一个关键词开始阅读。</p><div class="tag-grid">{tags.map(([tag, count]) => <a href={`/tags/${encodeURIComponent(tag)}`}><span>#{tag}</span><small>{count}</small></a>)}</div></section>
</BaseLayout>
<style>
 .tags { margin:32px 0 55px; padding:32px 29px; border:1px solid var(--line); border-radius:8px; background:#fff; box-shadow:0 2px 6px #6a51310a; } .tag-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; } .tag-grid a { display:flex; justify-content:space-between; align-items:center; padding:15px; border:1px solid var(--line); font:15px system-ui,sans-serif; } .tag-grid a:hover { background:var(--soft); border-color:#ead6bd; color:var(--accent); } small { color:var(--muted); }
 @media(max-width:450px){.tag-grid{grid-template-columns:1fr}}
</style>
